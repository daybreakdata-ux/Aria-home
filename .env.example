# OpenRouter API Configuration
# Get your API key from https://openrouter.ai/keys
# For Vercel: Add this in Project Settings > Environment Variables
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Serper API Configuration (Google Search API)
# Get your API key from https://serper.dev/
# REQUIRED: Search functionality will not work without this
# For Vercel: Add this in Project Settings > Environment Variables
SERPER_API_KEY=your_serper_api_key_here

# Node Environment (automatically set by Vercel)
# NODE_ENV=production
